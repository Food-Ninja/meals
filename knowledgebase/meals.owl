                        <owl:onProperty rdf:resource="http://purl.org/meals#radius_lower_bound_relative"/>
                        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.7</owl:hasValue>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.org/meals#radius_upper_bound_relative"/>
                        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.7</owl:hasValue>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">circular motion</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/meals#cream -->

    <owl:Class rdf:about="http://purl.org/meals#cream">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#Liquids"/>

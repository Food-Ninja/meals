        <meals1:verb xml:lang="en">reheat</meals1:verb>
    </owl:Class>
    


    <!-- http://purl.org/meals#Removing -->

    <owl:Class rdf:about="http://purl.org/meals#Removing">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#PreparationTask"/>
        <meals1:verb xml:lang="en">remove</meals1:verb>
    </owl:Class>
    


    <!-- http://purl.org/meals#Roasting -->

    <owl:Class rdf:about="http://purl.org/meals#Roasting">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#Frying"/>
        <meals1:verb xml:lang="en">roast</meals1:verb>
    </owl:Class>
    


    <!-- http://purl.org/meals#Rolling -->

    <owl:Class rdf:about="http://purl.org/meals#Rolling">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#ShapeChanging"/>
        <meals1:verb xml:lang="en">roll</meals1:verb>
    </owl:Class>
    


    <!-- http://purl.org/meals#Round -->

    <owl:Class rdf:about="http://purl.org/meals#Round">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#Shape"/>
    </owl:Class>
    


    <!-- http://purl.org/meals#SaladBowl -->

    <owl:Class rdf:about="http://purl.org/meals#SaladBowl">
        <rdfs:subClassOf rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#Bowl"/>
    </owl:Class>
    


    <!-- http://purl.org/meals#Sawing -->

    <owl:Class rdf:about="http://purl.org/meals#Sawing">
        <rdfs:subClassOf rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#Cutting"/>
        <meals1:verb xml:lang="en">saw</meals1:verb>
    </owl:Class>
    


    <!-- http://purl.org/meals#Scraping -->

    <owl:Class rdf:about="http://purl.org/meals#Scraping">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#FoodPreparationTask"/>
        <meals1:verb xml:lang="en">scrape</meals1:verb>
    </owl:Class>
    


    <!-- http://purl.org/meals#Seeds -->

    <owl:Class rdf:about="http://purl.org/meals#Seeds">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#PartInside"/>
        <rdfs:comment xml:lang="de">Samen / Kerne (z.B. Wassermelone, Apfel)</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/meals#Semicircle -->

    <owl:Class rdf:about="http://purl.org/meals#Semicircle">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#Shape"/>
    </owl:Class>
    


    <!-- http://purl.org/meals#Semioval -->

    <owl:Class rdf:about="http://purl.org/meals#Semioval">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#Shape"/>
    </owl:Class>
    


    <!-- http://purl.org/meals#Setting -->

    <owl:Class rdf:about="http://purl.org/meals#Setting">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#Placing"/>
        <meals1:verb xml:lang="en">set</meals1:verb>
    </owl:Class>
    


    <!-- http://purl.org/meals#Shaker -->

    <owl:Class rdf:about="http://purl.org/meals#Shaker">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#Container"/>
        <rdfs:comment>A salt or pepper shaker to sprinkle something.</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/meals#Shaking -->

    <owl:Class rdf:about="http://purl.org/meals#Shaking">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#Sprinkling"/>
    </owl:Class>
    


    <!-- http://purl.org/meals#Shape -->

    <owl:Class rdf:about="http://purl.org/meals#Shape">
        <rdfs:subClassOf rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#PhysicalQuality"/>
        <rdfs:comment>The shape of an object.</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/meals#ShapeChanging -->

    <owl:Class rdf:about="http://purl.org/meals#ShapeChanging">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#PreparationTask"/>
    </owl:Class>
    


    <!-- http://purl.org/meals#Shell -->

    <owl:Class rdf:about="http://purl.org/meals#Shell">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#PartOutside"/>
        <rdfs:comment xml:lang="de">Schale / Gehäuse (z.B. Nüsse)</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/meals#ShouldBeAvoided -->

    <owl:Class rdf:about="http://purl.org/meals#ShouldBeAvoided">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#Inedible"/>
    </owl:Class>
    


    <!-- http://purl.org/meals#Shutting -->

    <owl:Class rdf:about="http://purl.org/meals#Shutting">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#PickPlaceTask"/>
        <meals1:verb xml:lang="en">shut</meals1:verb>
    </owl:Class>
    


    <!-- http://purl.org/meals#Sieve -->

    <owl:Class rdf:about="http://purl.org/meals#Sieve">
        <rdfs:subClassOf rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#Tool"/>
        <rdfs:comment>A sieve is intended for draining liquids.</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/meals#Simmering -->

    <owl:Class rdf:about="http://purl.org/meals#Simmering">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#Cooking"/>
        <meals1:verb xml:lang="en">simmer</meals1:verb>
    </owl:Class>
    


    <!-- http://purl.org/meals#Sixteenth -->

    <owl:Class rdf:about="http://purl.org/meals#Sixteenth">
        <rdfs:subClassOf rdf:resource="http://qudt.org/schema/qudt#CountingUnit"/>
    </owl:Class>
    


    <!-- http://purl.org/meals#SkinOrPeel -->

    <owl:Class rdf:about="http://purl.org/meals#SkinOrPeel">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#PartOutside"/>
        <rdfs:comment xml:lang="de">Haut / Schale (z.B. Apfel, Orange)</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/meals#Slice -->

    <owl:Class rdf:about="http://purl.org/meals#Slice">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#Shape"/>
    </owl:Class>
    


    <!-- http://purl.org/meals#SlicingPosition -->

    <owl:Class rdf:about="http://purl.org/meals#SlicingPosition">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#CuttingPosition"/>
        <rdfs:comment>Cutting at the end of the object.</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/meals#Slivering -->

    <owl:Class rdf:about="http://purl.org/meals#Slivering">
        <rdfs:subClassOf rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#Slicing"/>
        <meals1:verb xml:lang="en">sliver</meals1:verb>
    </owl:Class>
    


    <!-- http://purl.org/meals#Snipping -->

    <owl:Class rdf:about="http://purl.org/meals#Snipping">
        <rdfs:subClassOf rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#Slicing"/>
        <meals1:verb xml:lang="en">snip</meals1:verb>
    </owl:Class>
    


    <!-- http://purl.org/meals#Soaking -->

    <owl:Class rdf:about="http://purl.org/meals#Soaking">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#PreparationTask"/>
        <meals1:verb>infuse</meals1:verb>
        <meals1:verb xml:lang="en">soak</meals1:verb>
    </owl:Class>
    


    <!-- http://purl.org/meals#Spilling -->

    <owl:Class rdf:about="http://purl.org/meals#Spilling">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#PouringTask"/>
        <meals1:verb xml:lang="en">spill</meals1:verb>
    </owl:Class>
    


    <!-- http://purl.org/meals#Splashing -->

    <owl:Class rdf:about="http://purl.org/meals#Splashing">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#Pouring"/>
        <meals1:verb xml:lang="en">splash</meals1:verb>
    </owl:Class>
    


    <!-- http://purl.org/meals#Sprinkling -->

    <owl:Class rdf:about="http://purl.org/meals#Sprinkling">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#PouringTask"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/meals#hasInputObject"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/meals#Food"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/meals#hasParameter"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/meals#PouringDuration"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasParticipant"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/meals#Shaker"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <meals1:verb xml:lang="en">sprinkle</meals1:verb>
    </owl:Class>
    


    <!-- http://purl.org/meals#Steaming -->

    <owl:Class rdf:about="http://purl.org/meals#Steaming">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#Cooking"/>
        <meals1:verb xml:lang="en">steam</meals1:verb>
    </owl:Class>
    


    <!-- http://purl.org/meals#Stem -->

    <owl:Class rdf:about="http://purl.org/meals#Stem">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#PartOutside"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#hasDisposition"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.org/meals#StemRemovability"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#affordsTask"/>
                                <owl:someValuesFrom rdf:resource="http://purl.org/meals#StemRemoving"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="de">Stiel / Stängel (z.B. Apfel, Kirsche)</rdfs:comment>
    </owl:Class>
    



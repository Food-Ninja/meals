        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#classifies"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/meals#PickPlaceAction"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A collection of tasks that commonly occur in recipe instructions that require picking (taking) and/ or placing food objects.</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/meals#Picking -->

    <owl:Class rdf:about="http://purl.org/meals#Picking">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#PickPlaceTask"/>
        <meals1:verb xml:lang="en">pick</meals1:verb>
    </owl:Class>
    


    <!-- http://purl.org/meals#Piece -->

    <owl:Class rdf:about="http://purl.org/meals#Piece">
        <rdfs:subClassOf rdf:resource="http://qudt.org/schema/qudt#CountingUnit"/>
    </owl:Class>
    


    <!-- http://purl.org/meals#Piling -->

    <owl:Class rdf:about="http://purl.org/meals#Piling">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#Arranging"/>
        <meals1:verb xml:lang="en">pile</meals1:verb>
    </owl:Class>
    


    <!-- http://purl.org/meals#Pit -->

    <owl:Class rdf:about="http://purl.org/meals#Pit">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#PartInside"/>
        <rdfs:comment xml:lang="de">Kern / Stein (z.B. Pfirsich, Kirsche)</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/meals#Placing -->

    <owl:Class rdf:about="http://purl.org/meals#Placing">

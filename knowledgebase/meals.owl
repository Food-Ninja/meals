    <!-- http://purl.org/meals#Filleting -->

    <owl:Class rdf:about="http://purl.org/meals#Filleting">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#FoodPreparationTask"/>
        <meals1:verb>fillet</meals1:verb>
    </owl:Class>
    


    <!-- http://purl.org/meals#Filling -->

    <owl:Class rdf:about="http://purl.org/meals#Filling">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#PreparationTask"/>
        <meals1:verb xml:lang="en">fill</meals1:verb>
    </owl:Class>
    


    <!-- http://purl.org/meals#Flattening -->

    <owl:Class rdf:about="http://purl.org/meals#Flattening">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#ShapeChanging"/>
        <meals1:verb xml:lang="en">flatten</meals1:verb>
    </owl:Class>
    


    <!-- http://purl.org/meals#FleshOrPulp -->

    <owl:Class rdf:about="http://purl.org/meals#FleshOrPulp">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#PartInside"/>
        <rdfs:comment xml:lang="de">Fruchtfleisch</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/meals#Flowing -->

    <owl:Class rdf:about="http://purl.org/meals#Flowing">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#Pouring"/>
        <meals1:verb xml:lang="en">flow</meals1:verb>
    </owl:Class>
    


    <!-- http://purl.org/meals#Folding -->

    <owl:Class rdf:about="http://purl.org/meals#Folding">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#MixingTask"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/meals#hasInputObject"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/meals#Food"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/meals#requiresMotion"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/meals#orbital"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#affordsTrigger"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/meals#MixingTool"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://purl.org/meals#Food -->

    <owl:Class rdf:about="http://purl.org/meals#Food">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#PhysicalObject"/>
        <meals1:synonym xml:lang="en">content</meals1:synonym>
        <meals1:synonym xml:lang="en">ingredient</meals1:synonym>
        <rdfs:comment>Food objects that can be found in recipes. This list contains food objects that occur in more than 1% of all recipes in the Recipe1M corpus.</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/meals#FoodPart -->

    <owl:Class rdf:about="http://purl.org/meals#FoodPart">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#Food"/>
        <rdfs:comment>Parts of food objects that might require additional handling (such as a peel that needs to be removed).</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/meals#FoodPreparationTask -->

    <owl:Class rdf:about="http://purl.org/meals#FoodPreparationTask">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#PreparationTask"/>
    </owl:Class>
    


    <!-- http://purl.org/meals#Fork -->

    <owl:Class rdf:about="http://purl.org/meals#Fork">
        <rdfs:subClassOf rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#Cutlery"/>
    </owl:Class>
    


    <!-- http://purl.org/meals#Freezing -->

    <owl:Class rdf:about="http://purl.org/meals#Freezing">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#Cooling"/>
        <meals1:verb xml:lang="en">freeze</meals1:verb>
    </owl:Class>
    


    <!-- http://purl.org/meals#Frying -->

    <owl:Class rdf:about="http://purl.org/meals#Frying">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#CookCoolTask"/>
        <meals1:verb xml:lang="en">fry</meals1:verb>
    </owl:Class>
    


    <!-- http://purl.org/meals#Fusing -->

    <owl:Class rdf:about="http://purl.org/meals#Fusing">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#Mixing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/meals#requiresMotion"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/meals#spiral"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#affordsTrigger"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/meals#MixingTool"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/meals#hasInputObject"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://purl.org/meals#Food"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <meals1:verb xml:lang="en">fuse</meals1:verb>
    </owl:Class>
    


    <!-- http://purl.org/meals#Gathering -->

    <owl:Class rdf:about="http://purl.org/meals#Gathering">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#Picking"/>
        <meals1:verb xml:lang="en">gather</meals1:verb>
    </owl:Class>
    


    <!-- http://purl.org/meals#Grilling -->

    <owl:Class rdf:about="http://purl.org/meals#Grilling">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#CookCoolTask"/>
        <meals1:verb xml:lang="en">Grilling</meals1:verb>
    </owl:Class>
    


    <!-- http://purl.org/meals#Grouping -->

    <owl:Class rdf:about="http://purl.org/meals#Grouping">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#MixingTask"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/meals#requiresMotion"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/meals#orbital"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#affordsTrigger"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/meals#MixingTool"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/meals#hasInputObject"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://purl.org/meals#Food"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <meals1:verb xml:lang="en">group</meals1:verb>
    </owl:Class>
    


    <!-- http://purl.org/meals#Halve -->

    <owl:Class rdf:about="http://purl.org/meals#Halve">
        <rdfs:subClassOf rdf:resource="http://qudt.org/schema/qudt#CountingUnit"/>
    </owl:Class>
    


    <!-- http://purl.org/meals#Halving -->

    <owl:Class rdf:about="http://purl.org/meals#Halving">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#CuttingTask"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.org/meals#hasInputObject"/>
                        <owl:someValuesFrom rdf:resource="http://purl.org/meals#Food"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.org/meals#hasResultObject"/>
                        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:qualifiedCardinality>
                        <owl:onClass rdf:resource="http://purl.org/meals#Halve"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/meals#affordsPosition"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/meals#HalvingPosition"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/meals#repetitions"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <meals1:verb xml:lang="en">halve</meals1:verb>
        <rdfs:comment xml:lang="en">Cut the object into halves</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/meals#HalvingPosition -->

    <owl:Class rdf:about="http://purl.org/meals#HalvingPosition">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#CuttingPosition"/>

            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">cream</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/meals#drink -->

    <owl:Class rdf:about="http://purl.org/meals#drink">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#Liquids"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/meals#hasConsistency"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/meals#Liquid"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">drink</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/meals#elliptical -->

    <owl:Class rdf:about="http://purl.org/meals#elliptical">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#MixingMotion"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.org/meals#radius_lower_bound_relative"/>
                        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.0</owl:hasValue>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.org/meals#radius_upper_bound_relative"/>
                        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.7</owl:hasValue>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/meals#ellipse_shift"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.04</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">elliptical motion</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/meals#folding -->

    <owl:Class rdf:about="http://purl.org/meals#folding">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#MixingMotion"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.org/meals#radius_lower_bound_relative"/>
                        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.0</owl:hasValue>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.org/meals#radius_upper_bound_relative"/>
                        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.7</owl:hasValue>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/meals#folding_rotation_shift"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">90</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/meals#repetitive_folding_rotation_shift"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">22.5</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">folding motion</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/meals#grease -->

    <owl:Class rdf:about="http://purl.org/meals#grease">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#Liquids"/>
        <meals1:synonym xml:lang="en">fat</meals1:synonym>
        <rdfs:label xml:lang="en">grease</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/meals#marinade -->

    <owl:Class rdf:about="http://purl.org/meals#marinade">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#Mixtures"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/meals#hasConsistency"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.org/meals#Dry"/>
                            <rdf:Description rdf:about="http://purl.org/meals#Liquid"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">marinade</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/meals#meat -->

    <owl:Class rdf:about="http://purl.org/meals#meat">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#Food"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/meals#hasConsistency"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/meals#Moist"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://purl.org/meals#orbital -->

    <owl:Class rdf:about="http://purl.org/meals#orbital">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#MixingMotion"/>
        <rdfs:label>orbital motion</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/meals#puree -->

    <owl:Class rdf:about="http://purl.org/meals#puree">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#Liquids"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/meals#hasConsistency"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/meals#Viscuous"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">puree</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/meals#smoothie -->

    <owl:Class rdf:about="http://purl.org/meals#smoothie">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#Liquids"/>
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#Mixtures"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/meals#hasConsistency"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/meals#Viscuous"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">smoothie</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/meals#spiral -->

    <owl:Class rdf:about="http://purl.org/meals#spiral">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#MixingMotion"/>
        <rdfs:label>spiral motion</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/meals#stone_fruit -->

    <owl:Class rdf:about="http://purl.org/meals#stone_fruit">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00001057"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/meals#hasPart"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.org/meals#Core"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.org/meals#hasEdibility"/>
                                <owl:someValuesFrom rdf:resource="http://purl.org/meals#MustBeAvoided"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#hasDisposition"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.org/meals#CoreRemovability"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#affordsTask"/>
                                <owl:someValuesFrom rdf:resource="http://purl.org/meals#CoreCutting"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#affordsTrigger"/>
                                <owl:allValuesFrom>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#classifies"/>
                                        <owl:allValuesFrom rdf:resource="http://purl.org/meals#Knife"/>
                                    </owl:Restriction>
                                </owl:allValuesFrom>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#hasDisposition"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.ease-crc.org/ont/situation_awareness#Cuttability"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#affordsTask"/>
                                <owl:someValuesFrom rdf:resource="http://purl.org/meals#CuttingTask"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#affordsTrigger"/>
                                <owl:allValuesFrom>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#classifies"/>
                                        <owl:allValuesFrom rdf:resource="http://purl.org/meals#Knife"/>
                                    </owl:Restriction>
                                </owl:allValuesFrom>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://purl.org/meals#10Seconds -->

    <owl:Class rdf:about="http://purl.org/meals#10Seconds">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#PouringDuration"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/meals#hasInputObject"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.org/meals#Food"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.org/meals#hasConsistency"/>
                                <owl:someValuesFrom>
                                    <owl:Class>
                                        <owl:unionOf rdf:parseType="Collection">
                                            <rdf:Description rdf:about="http://purl.org/meals#Dry"/>
                                            <rdf:Description rdf:about="http://purl.org/meals#Moist"/>
                                            <rdf:Description rdf:about="http://purl.org/meals#Powdery"/>
                                            <rdf:Description rdf:about="http://purl.org/meals#Viscuous"/>
                                        </owl:unionOf>
                                    </owl:Class>
                                </owl:someValuesFrom>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://qudt.org/schema/qudt#hasQuantity"/>
                <owl:someValuesFrom rdf:resource="http://qudt.org/schema/qudt/Second"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://qudt.org/schema/qudt#valueQuantity"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">4</owl:minQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://qudt.org/schema/qudt#valueQuantity"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">11</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://purl.org/meals#2Seconds -->

    <owl:Class rdf:about="http://purl.org/meals#2Seconds">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#PouringDuration"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/meals#hasInputObject"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.org/meals#Food"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.org/meals#hasConsistency"/>
                                <owl:allValuesFrom rdf:resource="http://purl.org/meals#Liquid"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://qudt.org/schema/qudt#hasQuantity"/>
                <owl:someValuesFrom rdf:resource="http://qudt.org/schema/qudt/Second"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://qudt.org/schema/qudt#valueQuantity"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://qudt.org/schema/qudt#valueQuantity"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">3</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://purl.org/meals#45Degree -->

    <owl:Class rdf:about="http://purl.org/meals#45Degree">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#PouringAngle"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/meals#hasInputObject"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.org/meals#Food"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.org/meals#hasConsistency"/>
                                <owl:allValuesFrom rdf:resource="http://purl.org/meals#Liquid"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://qudt.org/schema/qudt#hasQuantity"/>
                <owl:someValuesFrom rdf:resource="http://qudt.org/schema/qudt/Degree"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://qudt.org/schema/qudt#valueQuantity"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://qudt.org/schema/qudt#valueQuantity"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">45</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://purl.org/meals#90Degree -->

    <owl:Class rdf:about="http://purl.org/meals#90Degree">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#PouringAngle"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/meals#hasInputObject"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.org/meals#Food"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.org/meals#hasConsistency"/>
                                <owl:someValuesFrom>
                                    <owl:Class>
                                        <owl:unionOf rdf:parseType="Collection">
                                            <rdf:Description rdf:about="http://purl.org/meals#Dry"/>
                                            <rdf:Description rdf:about="http://purl.org/meals#Moist"/>
                                            <rdf:Description rdf:about="http://purl.org/meals#Powdery"/>
                                            <rdf:Description rdf:about="http://purl.org/meals#Viscuous"/>
                                        </owl:unionOf>
                                    </owl:Class>
                                </owl:someValuesFrom>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://qudt.org/schema/qudt#hasQuantity"/>
                <owl:someValuesFrom rdf:resource="http://qudt.org/schema/qudt/Degree"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://qudt.org/schema/qudt#valueQuantity"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">46</owl:minQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://qudt.org/schema/qudt#valueQuantity"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">100</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://qudt.org/schema/qudt#CountingUnit -->

    <owl:Class rdf:about="http://qudt.org/schema/qudt#CountingUnit">
        <rdfs:subClassOf rdf:resource="http://qudt.org/schema/qudt#ResourceUnit"/>
        <rdfs:comment>A counting unit of a quantity.</rdfs:comment>
    </owl:Class>
    


    <!-- http://qudt.org/schema/qudt#ResourceUnit -->

    <owl:Class rdf:about="http://qudt.org/schema/qudt#ResourceUnit">
        <rdfs:subClassOf rdf:resource="http://qudt.org/schema/qudt/Quantity"/>
        <rdfs:comment>A unit quantity of a resource.</rdfs:comment>
    </owl:Class>
    


    <!-- http://qudt.org/schema/qudt/Degree -->

    <owl:Class rdf:about="http://qudt.org/schema/qudt/Degree">
        <rdfs:subClassOf rdf:resource="http://qudt.org/schema/qudt/Quantity"/>
        <rdfs:comment>The angle quantity.</rdfs:comment>
    </owl:Class>
    


    <!-- http://qudt.org/schema/qudt/Quantity -->

    <owl:Class rdf:about="http://qudt.org/schema/qudt/Quantity">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Entity"/>
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#SocialObject"/>
        <rdfs:comment>A Quantity is the measurement of an observable property of a particular object, event, or physical system.</rdfs:comment>
    </owl:Class>
    


    <!-- http://qudt.org/schema/qudt/Second -->

    <owl:Class rdf:about="http://qudt.org/schema/qudt/Second">
        <rdfs:subClassOf rdf:resource="http://qudt.org/schema/qudt/Quantity"/>
        <rdfs:comment>A time quantity.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.ease-crc.org/ont/SOMA-HOME.owl#KitchenKnife -->

    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA-HOME.owl#KitchenKnife">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#CoreRemovalTool"/>
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#Knife"/>
        <rdfs:comment xml:lang="de">Küchenmesser</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.ease-crc.org/ont/SOMA.owl#Bowl -->

    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#Bowl">
        <rdfs:subClassOf rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#Crockery"/>
        <rdfs:label xml:lang="en">bowl</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ease-crc.org/ont/SOMA.owl#Bread -->

    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#Bread">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#Food"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#hasDisposition"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.ease-crc.org/ont/situation_awareness#Cuttability"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#affordsTask"/>
                                <owl:allValuesFrom rdf:resource="http://purl.org/meals#CuttingTask"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#affordsTrigger"/>
                                <owl:allValuesFrom>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#classifies"/>
                                        <owl:allValuesFrom rdf:resource="http://purl.org/meals#Knife"/>
                                    </owl:Restriction>
                                </owl:allValuesFrom>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.ease-crc.org/ont/SOMA.owl#Crockery -->

    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#Crockery">
        <rdfs:subClassOf rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#Tool"/>
        <rdfs:comment>Pots, pans, etc.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.ease-crc.org/ont/SOMA.owl#Cup -->

    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#Cup">
        <rdfs:subClassOf rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#Crockery"/>
    </owl:Class>
    


    <!-- http://www.ease-crc.org/ont/SOMA.owl#Cutlery -->

    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#Cutlery">
        <rdfs:subClassOf rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#Tool"/>
        <rdfs:comment>Knifes, Forks, Spoons, etc.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.ease-crc.org/ont/SOMA.owl#Cutting -->

    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#Cutting">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#CuttingTask"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.org/meals#hasInputObject"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://purl.org/meals#Food"/>
                                    <rdf:Description rdf:about="http://purl.org/meals#FoodPart"/>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.org/meals#hasResultObject"/>
                        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                        <owl:onClass rdf:resource="http://purl.org/meals#FoodPart"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.org/meals#hasResultObject"/>
                        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                        <owl:onClass rdf:resource="http://purl.org/meals#Slice"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/meals#affordsPosition"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/meals#SlicingPosition"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/meals#repetitions"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <meals1:verb xml:lang="en">cut</meals1:verb>
    </owl:Class>
    


    <!-- http://www.ease-crc.org/ont/SOMA.owl#CuttingTool -->

    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#CuttingTool">
        <rdfs:subClassOf rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#Cutlery"/>
    </owl:Class>
    


    <!-- http://www.ease-crc.org/ont/SOMA.owl#Dicing -->

    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#Dicing">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#CuttingTask"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.org/meals#hasInputObject"/>
                        <owl:someValuesFrom rdf:resource="http://purl.org/meals#Stripe"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.org/meals#hasResultObject"/>
                        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                        <owl:onClass rdf:resource="http://purl.org/meals#Cube"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.org/meals#hasResultObject"/>
                        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                        <owl:onClass rdf:resource="http://purl.org/meals#Stripe"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/meals#affordsPosition"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/meals#SlicingPosition"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/meals#requiresPriorTask"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/meals#Julienning"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/meals#repetitions"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <meals1:verb xml:lang="en">dice</meals1:verb>
        <rdfs:comment xml:lang="en">Cut an object into Cubes</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.ease-crc.org/ont/SOMA.owl#Disposition -->

    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#Disposition">
        <rdfs:subClassOf rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#PhysicalQuality"/>
        <rdfs:comment>The tendency of an object (the bearer) to make certain events happen with others (the triggers).</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.ease-crc.org/ont/SOMA.owl#Feature -->

    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#Feature">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Object"/>
        <rdfs:comment>Features are &apos;parasitic&apos; entities that only exist insofar their host exists. Typical examples are holes, bumps, boundaries, or spots of color.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.ease-crc.org/ont/SOMA.owl#Hand -->

    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#Hand">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#PeelingTool"/>
        <rdfs:comment xml:lang="en">Hand as a tool to e.g. peel a banana</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.ease-crc.org/ont/SOMA.owl#Pan -->

    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#Pan">
        <rdfs:subClassOf rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#Crockery"/>
    </owl:Class>
    


    <!-- http://www.ease-crc.org/ont/SOMA.owl#PhysicalQuality -->

    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#PhysicalQuality">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Entity"/>
        <rdfs:comment>Any aspect of an entity that is dependent on its physical manifestation.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.ease-crc.org/ont/SOMA.owl#Pot -->

    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#Pot">
        <rdfs:subClassOf rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#Crockery"/>
    </owl:Class>
    


    <!-- http://www.ease-crc.org/ont/SOMA.owl#Slicing -->

    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#Slicing">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#CuttingTask"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.org/meals#hasInputObject"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://purl.org/meals#Food"/>
                                    <rdf:Description rdf:about="http://purl.org/meals#FoodPart"/>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.org/meals#hasResultObject"/>
                        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                        <owl:onClass rdf:resource="http://purl.org/meals#FoodPart"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.org/meals#hasResultObject"/>
                        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                        <owl:onClass rdf:resource="http://purl.org/meals#Slice"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/meals#affordsPosition"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/meals#SlicingPosition"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/meals#repetitions"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <meals1:verb xml:lang="en">slice</meals1:verb>
        <rdfs:comment xml:lang="en">cut the object into multiple slices</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.ease-crc.org/ont/SOMA.owl#Spoon -->

    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#Spoon">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#CoreRemovalTool"/>
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#MixingTool"/>
        <rdfs:subClassOf rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#Cutlery"/>
        <rdfs:comment xml:lang="en">Spoon to scoop out sth,</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.ease-crc.org/ont/SOMA.owl#Tool -->

    <owl:Class rdf:about="http://www.ease-crc.org/ont/SOMA.owl#Tool">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#PhysicalObject"/>
        <rdfs:comment>A tool is an object that is used for a specific task, e.g. a spoon for stirring.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.ease-crc.org/ont/situation_awareness#BreadKnife -->

    <owl:Class rdf:about="http://www.ease-crc.org/ont/situation_awareness#BreadKnife">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#Knife"/>
        <rdfs:comment xml:lang="de">Brotmesser</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.ease-crc.org/ont/situation_awareness#Cuttability -->

    <owl:Class rdf:about="http://www.ease-crc.org/ont/situation_awareness#Cuttability">
        <rdfs:subClassOf rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#Disposition"/>
    </owl:Class>
    


    <!-- http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Action -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Action">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Event"/>
        <rdfs:comment>We assume an action where an agent actively changes something through manipulation/ its own body motions.

An action is related to a task, which links to execution parameters of the robot.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Concept -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Concept">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#SocialObject"/>
        <rdfs:comment>A Concept is a SocialObject, and isDefinedIn some Description; once defined, a Concept can be used in other Description(s). If a Concept isDefinedIn exactly one Description, see the LocalConcept class.
The classifies relation relates Concept(s) to Entity(s) at some TimeInterval

Here, tasks are social objects that classify actions as events at some time.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Entity -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Entity">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment>Anything: real, possible, or imaginary, which some modeller wants to talk about for some purpose.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Event -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Event">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Entity"/>
        <rdfs:comment>Any physical, social, or mental process, event, or state.

More theoretically, events can be classified in different ways, possibly based on &apos;aspect&apos; (e.g. stative, continuous, accomplishement, achievement, etc.), on &apos;agentivity&apos; (e.g. intentional, natural, etc.), or on &apos;typical participants&apos; (e.g. human, physical, abstract, food, etc.).

Here, we use events as descriptions of actions, where we assume an agent being involved in a situation and actively changing something through manipulation/ its own body motions.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#EventType -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#EventType">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Concept"/>
        <rdfs:comment>A Concept that classifies an Event . An event type describes how an Event should be interpreted, executed, expected, seen, etc., according to the Description that the EventType isDefinedIn (or used in)</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Object -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Object">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Entity"/>
        <rdfs:comment>Any physical, social, or mental object, or a substance. Following DOLCE Full, objects are always participating in some event (at least their own life), and are spatially located.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Parameter -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Parameter">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Concept"/>
        <rdfs:comment>A Concept that classifies a Region; the difference between a Region and a Parameter is that regions represent sets of observable values, e.g. the height  of a given building, while parameters represent constraints or selections on observable values, e.g. &apos;VeryHigh&apos;. Therefore, parameters can also be used to constrain regions, e.g. VeryHigh on a subset of values of the Region Height applied to buildings, or to add an external selection criterion , such as measurement units, to regions, e.g. Meter on a subset of values from the Region Length applied to the Region Length applied to roads.

Some of the parameters we assign here are more concrete than others, but all are used more in the sense of range/ restricting values to guide robotic behavior. The concretevalues are calculated in the robot control program during execution or planning.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#PhysicalObject -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#PhysicalObject">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Object"/>
        <rdfs:comment>Any Object that has a proper space region. The prototypical physical object has also an associated mass, but the nature of its mass can greatly vary based on the epistemological status of the object (scientifically measured, subjectively possible, imaginary).</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#SocialObject -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#SocialObject">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Object"/>
        <rdfs:comment>Any Object that exists only within some communication Event, in which at least one PhysicalObject participates in. 
In other words, all objects that have been or are created in the process of social communication: for the sake of communication (InformationObject), for incorporating new individuals (SocialAgent, Place), for contextualizing or intepreting existing entities (Description, Concept), or for collecting existing entities (Collection).
Being dependent on communication, all social objects need to be expressed by some information object (information objects are self-expressing).

Here, we use recipe instructions as communication Events that contain tasks as social objects.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Task -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Task">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#EventType"/>
        <rdfs:comment>A task refers to a low-level motion sequence with body motion parameters. Tasks link from recipe instructions to motion parameters so that they can be executed by a robot.</rdfs:comment>
        <rdfs:label xml:lang="en">task</rdfs:label>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/meals#Green -->

    <owl:NamedIndividual rdf:about="http://purl.org/meals#Green"/>
</rdf:RDF>




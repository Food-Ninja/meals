        <meals1:verb xml:lang="en">divide</meals1:verb>
    </owl:Class>
    


    <!-- http://purl.org/meals#Draining -->

    <owl:Class rdf:about="http://purl.org/meals#Draining">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#PouringThrough"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasParticipant"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/meals#Sieve"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <meals1:verb xml:lang="en">drain</meals1:verb>

    </owl:Class>
    


    <!-- http://purl.org/meals#Edibility -->

    <owl:Class rdf:about="http://purl.org/meals#Edibility">
        <rdfs:subClassOf rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#Disposition"/>
    </owl:Class>
    


    <!-- http://purl.org/meals#Edible -->

    <owl:Class rdf:about="http://purl.org/meals#Edible">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#Edibility"/>
    </owl:Class>
    



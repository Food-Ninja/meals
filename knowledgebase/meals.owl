    </owl:Class>
    


    <!-- http://purl.org/meals#CoreScraping -->

    <owl:Class rdf:about="http://purl.org/meals#CoreScraping">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#CoreRemoving"/>
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#Scraping"/>
    </owl:Class>
    


    <!-- http://purl.org/meals#Covering -->

    <owl:Class rdf:about="http://purl.org/meals#Covering">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#Shutting"/>
    </owl:Class>
    



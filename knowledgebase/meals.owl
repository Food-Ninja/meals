    <owl:Class rdf:about="http://purl.org/meals#Concocting">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#Mixing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/meals#requiresMotion"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/meals#spiral"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#affordsTrigger"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/meals#MixingTool"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/meals#hasInputObject"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://purl.org/meals#Food"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <meals1:verb xml:lang="en">concoct</meals1:verb>
    </owl:Class>
    


    <!-- http://purl.org/meals#Conflating -->

    <owl:Class rdf:about="http://purl.org/meals#Conflating">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#Mixing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/meals#requiresMotion"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/meals#spiral"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#affordsTrigger"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/meals#MixingTool"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/meals#hasInputObject"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://purl.org/meals#Food"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <meals1:verb xml:lang="en">conflate</meals1:verb>
    </owl:Class>
    


    <!-- http://purl.org/meals#Consistency -->

    <owl:Class rdf:about="http://purl.org/meals#Consistency">
        <rdfs:subClassOf rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#Feature"/>
        <rdfs:comment>A consistency is a feature of a food object.</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/meals#Container -->

    <owl:Class rdf:about="http://purl.org/meals#Container">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#PhysicalObject"/>
        <rdfs:comment>A container is an object that affords to hold/ contain other objects.</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/meals#CookCoolAction -->

    <owl:Class rdf:about="http://purl.org/meals#CookCoolAction">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Action"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#executesTask"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/meals#CookCoolTask"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://purl.org/meals#CookCoolTask -->

    <owl:Class rdf:about="http://purl.org/meals#CookCoolTask">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Task"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#classifies"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/meals#CookCoolAction"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A collection of tasks that commonly occur in recipe instructions that require cooking (or heating) or cooling food objects.</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/meals#Cooking -->

    <owl:Class rdf:about="http://purl.org/meals#Cooking">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#CookCoolTask"/>
        <meals1:verb xml:lang="en">cook</meals1:verb>
    </owl:Class>
    


    <!-- http://purl.org/meals#Cooling -->

    <owl:Class rdf:about="http://purl.org/meals#Cooling">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#CookCoolTask"/>
        <meals1:verb xml:lang="en">cool</meals1:verb>
    </owl:Class>
    


    <!-- http://purl.org/meals#Core -->

    <owl:Class rdf:about="http://purl.org/meals#Core">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#PartInside"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#hasDisposition"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.org/meals#CoreRemovability"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#affordsTask"/>
                                <owl:someValuesFrom rdf:resource="http://purl.org/meals#CoreCutting"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#hasDisposition"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.org/meals#CoreRemovability"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#affordsTask"/>
                                <owl:someValuesFrom rdf:resource="http://purl.org/meals#CoreScraping"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="de">Kerngehäuse (z.B. Apfel, Birne)</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/meals#CoreCutting -->

    <owl:Class rdf:about="http://purl.org/meals#CoreCutting">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#CoreRemoving"/>
    </owl:Class>
    


    <!-- http://purl.org/meals#CoreRemovability -->

    <owl:Class rdf:about="http://purl.org/meals#CoreRemovability">
        <rdfs:subClassOf rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#Disposition"/>
    </owl:Class>
    


    <!-- http://purl.org/meals#CoreRemovalTool -->

    <owl:Class rdf:about="http://purl.org/meals#CoreRemovalTool">
        <rdfs:subClassOf rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#Cutlery"/>
    </owl:Class>
    


    <!-- http://purl.org/meals#CoreRemoving -->


    </owl:ObjectProperty>
    


    <!-- http://purl.org/meals#requiresPriorTask -->

    <owl:ObjectProperty rdf:about="http://purl.org/meals#requiresPriorTask">
        <rdfs:subPropertyOf rdf:resource="http://www.ease-crc.org/ont/meal_prep#hasPriorTask"/>

            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#classifies"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/meals#CuttingAction"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A collection of tasks that commonly occur in recipe instructions that require cutting food objects.</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/meals#Defrosting -->

    <owl:Class rdf:about="http://purl.org/meals#Defrosting">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#Heating"/>
        <meals1:verb xml:lang="en">defrost</meals1:verb>
    </owl:Class>
    


    <!-- http://purl.org/meals#Disposing -->

    <owl:Class rdf:about="http://purl.org/meals#Disposing">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#Arranging"/>
        <meals1:verb xml:lang="en">dispose</meals1:verb>
    </owl:Class>
    


    <!-- http://purl.org/meals#Dividing -->

    <owl:Class rdf:about="http://purl.org/meals#Dividing">

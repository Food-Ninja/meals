    </owl:DatatypeProperty>
    


    <!-- http://purl.org/meals#radius_lower_bound_absolute -->

    <owl:DatatypeProperty rdf:about="http://purl.org/meals#radius_lower_bound_absolute">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/meals#motion_parameters"/>
        <rdfs:label xml:lang="en">radius lower bound absolute</rdfs:label>

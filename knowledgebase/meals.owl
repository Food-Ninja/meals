        <rdfs:subPropertyOf rdf:resource="http://purl.org/meals#motion_parameters"/>
        <rdfs:label xml:lang="en">radius upper bound relative</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/meals#repetitions -->

    <owl:DatatypeProperty rdf:about="http://purl.org/meals#repetitions">
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Task"/>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/meals#repetitive_folding_rotation_shift -->

    <owl:DatatypeProperty rdf:about="http://purl.org/meals#repetitive_folding_rotation_shift">

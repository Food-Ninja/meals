    <!-- http://purl.obolibrary.org/obo/CHEBI_30879 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_30879">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#Liquids"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/meals#hasConsistency"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/meals#Liquid"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">alcohol</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ENVO_00003064 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ENVO_00003064">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#Liquids"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/meals#hasConsistency"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/meals#Liquid"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">drinking water</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00001057 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00001057">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#Food"/>
        <rdfs:label xml:lang="en">fruits</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00001178 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00001178">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#Liquids"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/meals#hasConsistency"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/meals#Viscuous"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">honey</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00001260 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00001260">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#Liquids"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/meals#hasConsistency"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/meals#Liquid"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">beer beverage</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00001649 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00001649">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#Food"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/meals#hasConsistency"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/meals#Powdery"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>black or white pepper</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00002385 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00002385">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#Food"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/meals#hasConsistency"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/meals#Powdery"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>baking soda</rdfs:label>
        <rdfs:label xml:lang="en">baking soda</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00003280 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00003280">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#Liquids"/>
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#Mixtures"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/meals#hasConsistency"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/meals#Liquid"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">soup (liquid)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00003415 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00003415">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/PO_0030111"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/meals#hasPart"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.org/meals#Peel"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.org/meals#hasEdibility"/>
                                <owl:someValuesFrom rdf:resource="http://purl.org/meals#Edible"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/meals#hasPart"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.org/meals#Stem"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.org/meals#hasEdibility"/>
                                <owl:someValuesFrom rdf:resource="http://purl.org/meals#ShouldBeAvoided"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#hasDisposition"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.org/meals#Peelability"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#affordsTask"/>
                                <owl:someValuesFrom rdf:resource="http://purl.org/meals#Peeling"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#affordsTrigger"/>
                                <owl:allValuesFrom>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#classifies"/>
                                        <owl:allValuesFrom rdf:resource="http://purl.org/meals#Peeler"/>
                                    </owl:Restriction>
                                </owl:allValuesFrom>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#hasDisposition"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.ease-crc.org/ont/situation_awareness#Cuttability"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#affordsTask"/>
                                <owl:someValuesFrom rdf:resource="http://purl.org/meals#CuttingTask"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#affordsTrigger"/>
                                <owl:allValuesFrom>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#classifies"/>
                                        <owl:allValuesFrom rdf:resource="http://purl.org/meals#Knife"/>
                                    </owl:Restriction>
                                </owl:allValuesFrom>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/meals#hasColor"/>
                <owl:hasValue rdf:resource="http://purl.org/meals#Green"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/meals#genus"/>
                <owl:hasValue>Cucumis</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">cucumber (whole)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/FOODON_00003443 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FOODON_00003443">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FOODON_00001057"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/meals#hasPart"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.org/meals#Stem"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.org/meals#hasEdibility"/>
                                <owl:someValuesFrom rdf:resource="http://purl.org/meals#ShouldBeAvoided"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#hasDisposition"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://www.ease-crc.org/ont/situation_awareness#Cuttability"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#affordsTask"/>
                                <owl:someValuesFrom rdf:resource="http://purl.org/meals#CuttingTask"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://www.ease-crc.org/ont/SOMA.owl#affordsTrigger"/>
                                <owl:allValuesFrom>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#classifies"/>
                                        <owl:allValuesFrom rdf:resource="http://purl.org/meals#Knife"/>
                                    </owl:Restriction>
                                </owl:allValuesFrom>

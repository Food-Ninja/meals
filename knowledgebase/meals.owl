        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/meals#ellipse_shift -->

    <owl:DatatypeProperty rdf:about="http://purl.org/meals#ellipse_shift">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/meals#motion_parameters"/>
        <rdfs:label xml:lang="en">ellipse shift</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/meals#folding_rotation_shift -->

    <owl:DatatypeProperty rdf:about="http://purl.org/meals#folding_rotation_shift">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/meals#motion_parameters"/>
        <rdfs:label xml:lang="en">folding rotation shift</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/meals#genus -->

    <owl:DatatypeProperty rdf:about="http://purl.org/meals#genus"/>
    


    <!-- http://purl.org/meals#height_increment -->


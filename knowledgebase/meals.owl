    <!-- http://purl.org/meals#Pouring -->

    <owl:Class rdf:about="http://purl.org/meals#Pouring">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#PouringTask"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/meals#hasInputObject"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/meals#Food"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/meals#hasParameter"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/meals#PouringAngle"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/meals#hasParameter"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/meals#PouringDuration"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <meals1:verb xml:lang="en">pour</meals1:verb>
    </owl:Class>
    


    <!-- http://purl.org/meals#PouringAction -->

    <owl:Class rdf:about="http://purl.org/meals#PouringAction">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Action"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#executesTask"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/meals#PouringTask"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://purl.org/meals#PouringAngle -->

    <owl:Class rdf:about="http://purl.org/meals#PouringAngle">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Parameter"/>
        <rdfs:comment>The angle required for a pouring task, defined through the object consistency.</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/meals#PouringDuration -->

    <owl:Class rdf:about="http://purl.org/meals#PouringDuration">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Parameter"/>
        <rdfs:comment>The duration required for a pouring task, defined through the object consistency.</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/meals#PouringTask -->

    <owl:Class rdf:about="http://purl.org/meals#PouringTask">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Task"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#classifies"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/meals#PouringAction"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A collection of tasks that commonly occur in recipe instructions that require pouring food objects.</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/meals#PouringThrough -->

    <owl:Class rdf:about="http://purl.org/meals#PouringThrough">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#PouringTask"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/meals#hasInputObject"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/meals#Food"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/meals#hasParameter"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/meals#PouringAngle"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/meals#hasParameter"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/meals#PouringDuration"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#hasParticipant"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/meals#Sieve"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <meals1:verb xml:lang="en">pour through</meals1:verb>
    </owl:Class>
    


    <!-- http://purl.org/meals#Powder -->

    <owl:Class rdf:about="http://purl.org/meals#Powder">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#Food"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/meals#hasConsistency"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/meals#Powdery"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">powder</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/meals#Powdery -->

    <owl:Class rdf:about="http://purl.org/meals#Powdery">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#Consistency"/>
        <rdfs:comment>Powdery consistency can be found in flour or sugar.</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/meals#PreparationAction -->

    <owl:Class rdf:about="http://purl.org/meals#PreparationAction">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Action"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#executesTask"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/meals#PreparationTask"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://purl.org/meals#PreparationTask -->

    <owl:Class rdf:about="http://purl.org/meals#PreparationTask">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Task"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#classifies"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/meals#PreparationAction"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A collection of tasks that commonly occur in recipe instructions that require the preparation of food objects. Here, preparation is a broad concept and also includes tasks that need further refinement. Since these tasks can not easily be executed by robots we handle them as preparation tasks.</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/meals#Putting -->

    <owl:Class rdf:about="http://purl.org/meals#Putting">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#Placing"/>
        <meals1:verb xml:lang="en">put</meals1:verb>
    </owl:Class>
    


    <!-- http://purl.org/meals#Quarter -->

    <owl:Class rdf:about="http://purl.org/meals#Quarter">
        <rdfs:subClassOf rdf:resource="http://qudt.org/schema/qudt#CountingUnit"/>
    </owl:Class>
    


    <!-- http://purl.org/meals#QuarterCoreRemoving -->

    <owl:Class rdf:about="http://purl.org/meals#QuarterCoreRemoving">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#CoreCutting"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.org/meals#hasInputObject"/>
                        <owl:someValuesFrom rdf:resource="http://purl.org/meals#Quarter"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.org/meals#hasResultObject"/>
                        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                        <owl:onClass rdf:resource="http://purl.org/meals#Quarter"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://purl.org/meals#Quartering -->

    <owl:Class rdf:about="http://purl.org/meals#Quartering">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#CuttingTask"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.org/meals#hasInputObject"/>
                        <owl:someValuesFrom rdf:resource="http://purl.org/meals#Halve"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.org/meals#hasResultObject"/>
                        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:qualifiedCardinality>
                        <owl:onClass rdf:resource="http://purl.org/meals#Quarter"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/meals#affordsPosition"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/meals#HalvingPosition"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/meals#requiresPriorTask"/>
                <owl:someValuesFrom rdf:resource="http://purl.org/meals#Halving"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.org/meals#repetitions"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <meals1:verb xml:lang="en">quarter</meals1:verb>
        <rdfs:comment xml:lang="en">Cut an object into Quarter</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/meals#Reaching -->

    <owl:Class rdf:about="http://purl.org/meals#Reaching">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#Picking"/>
        <meals1:verb xml:lang="en">reach</meals1:verb>
    </owl:Class>
    


    <!-- http://purl.org/meals#Refrigerating -->

    <owl:Class rdf:about="http://purl.org/meals#Refrigerating">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#Cooling"/>
        <meals1:verb xml:lang="en">refrigerate</meals1:verb>
    </owl:Class>
    


    <!-- http://purl.org/meals#Reheating -->

    <owl:Class rdf:about="http://purl.org/meals#Reheating">

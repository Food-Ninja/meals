    <!-- http://purl.org/meals#affordsPosition -->

    <owl:ObjectProperty rdf:about="http://purl.org/meals#affordsPosition"/>
    


    <!-- http://purl.org/meals#followedBy -->

    <owl:ObjectProperty rdf:about="http://purl.org/meals#followedBy">
        <rdfs:domain rdf:resource="http://purl.org/meals#MixingMotion"/>
        <rdfs:range rdf:resource="http://purl.org/meals#MixingMotion"/>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/meals#hasColor -->

    <owl:ObjectProperty rdf:about="http://purl.org/meals#hasColor"/>
    


    <!-- http://purl.org/meals#hasConsistency -->


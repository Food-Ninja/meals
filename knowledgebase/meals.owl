    <!-- http://purl.org/meals#hasEdibility -->

    <owl:ObjectProperty rdf:about="http://purl.org/meals#hasEdibility">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://purl.org/meals#FoodPart"/>
        <rdfs:range rdf:resource="http://purl.org/meals#Edibility"/>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/meals#hasInputObject -->

    <owl:ObjectProperty rdf:about="http://purl.org/meals#hasInputObject">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/meals#hasParameter -->

    <owl:ObjectProperty rdf:about="http://purl.org/meals#hasParameter"/>
    


    <!-- http://purl.org/meals#hasPart -->

    <owl:ObjectProperty rdf:about="http://purl.org/meals#hasPart">
        <owl:inverseOf rdf:resource="http://purl.org/meals#partOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://purl.org/meals#Food"/>
        <rdfs:range rdf:resource="http://purl.org/meals#FoodPart"/>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/meals#hasResultObject -->

    <owl:ObjectProperty rdf:about="http://purl.org/meals#hasResultObject">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:range rdf:resource="http://purl.org/meals#Shape"/>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/meals#partOf -->

    <owl:ObjectProperty rdf:about="http://purl.org/meals#partOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/meals#requiresMotion -->

    <owl:ObjectProperty rdf:about="http://purl.org/meals#requiresMotion">

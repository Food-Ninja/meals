    <!-- http://purl.org/meals#WhirlstormMotion -->

    <owl:Class rdf:about="http://purl.org/meals#WhirlstormMotion">
        <rdfs:subClassOf rdf:resource="http://purl.org/meals#MixingMotion"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.org/meals#radius_lower_bound_relative"/>
                        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.0</owl:hasValue>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.org/meals#radius_upper_bound_relative"/>
                        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.7</owl:hasValue>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">whirlstorm motion</rdfs:label>
    </owl:Class>
    



    <!-- http://purl.org/meals#CuttingAction -->

    <owl:Class rdf:about="http://purl.org/meals#CuttingAction">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Action"/>
    </owl:Class>
    


    <!-- http://purl.org/meals#CuttingPosition -->

    <owl:Class rdf:about="http://purl.org/meals#CuttingPosition">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Parameter"/>
        <rdfs:comment>A cutting position required for cutting tasks.</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/meals#CuttingTask -->

    <owl:Class rdf:about="http://purl.org/meals#CuttingTask">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/ont/dul/DUL.owl#Task"/>

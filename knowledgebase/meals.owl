        <rdfs:subPropertyOf rdf:resource="http://purl.org/meals#motion_parameters"/>
        <rdfs:label xml:lang="en">radius upper bound absolute</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/meals#radius_upper_bound_relative -->

